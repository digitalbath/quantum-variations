<jittershader name="quantum">
	<description>
		The device's display. A five-petal bloom in the centre — one petal per
		reservoir qubit, sized by that qubit's memory value — made of domain-warped
		noise whose amplitude follows the Variation dial and whose sharpness
		follows the readout's coherence. Around it a ring of one point per step of
		the phrase being generated, with a square on every step that carries a
		note. A ruler along the top shows the learned loop, one along the bottom
		the last generated phrase. Idle drifts, training spins and fills an arc,
		generating pulses.
	</description>
	<param name="time" type="float" default="0." />
	<param name="stage" type="float" default="0." />
	<param name="progress" type="float" default="0." />
	<param name="qa" type="vec4" default="0.5 0.5 0.5 0.5" />
	<param name="qb" type="float" default="0.5" />
	<param name="coherence" type="float" default="0.3" />
	<param name="pitch" type="float" default="0.4" />
	<param name="variation" type="float" default="1." />
	<param name="steps" type="float" default="16." />
	<param name="nlearn" type="float" default="0." />
	<param name="ngen" type="float" default="0." />
	<param name="aspect" type="float" default="2.325" />
	<param name="panel" type="vec3" default="0.216 0.216 0.216" />
	<param name="radius" type="float" default="0.06" />
	<param name="playing" type="float" default="0." />
	<param name="beat" type="float" default="0." />
	<param name="play" type="vec2" default="0. 0." />
	<param name="tex0" type="int" default="0" />
	<param name="tex1" type="int" default="1" />
	<param name="tex2" type="int" default="2" />
	<param name="nloss" type="float" default="0." />
	<language name="glsl" version="1.2">
		<bind param="time" program="fp" />
		<bind param="stage" program="fp" />
		<bind param="progress" program="fp" />
		<bind param="qa" program="fp" />
		<bind param="qb" program="fp" />
		<bind param="coherence" program="fp" />
		<bind param="pitch" program="fp" />
		<bind param="variation" program="fp" />
		<bind param="steps" program="fp" />
		<bind param="nlearn" program="fp" />
		<bind param="ngen" program="fp" />
		<bind param="aspect" program="fp" />
		<bind param="panel" program="fp" />
		<bind param="radius" program="fp" />
		<bind param="playing" program="fp" />
		<bind param="beat" program="fp" />
		<bind param="play" program="fp" />
		<bind param="tex0" program="fp" />
		<bind param="tex1" program="fp" />
		<bind param="tex2" program="fp" />
		<bind param="nloss" program="fp" />
		<program name="vp" type="vertex">
<![CDATA[
varying vec2 uv;
void main() {
	gl_Position = gl_ModelViewProjectionMatrix * gl_Vertex;
	uv = gl_MultiTexCoord0.st;
}
]]>
		</program>
		<program name="fp" type="fragment">
<![CDATA[
#version 120
#extension GL_ARB_texture_rectangle : enable
varying vec2 uv;
uniform float time, stage, progress, qb, coherence, pitch, variation, steps, nlearn, ngen, aspect;
uniform vec4 qa;
uniform vec3 panel;        // Live's device background, for the rounded corners
uniform float radius;      // corner radius, as a fraction of the view height / 2
uniform float playing;     // Live transport running
uniform float beat;        // phase within the current beat, 0..1 (plugsync~)
uniform vec2 play;         // x: what the track plays (0 other, 1 source, 2 generated); y: step
uniform sampler2DRect tex0;   // learned loop: 256 x 1, red = pitch / 255
uniform sampler2DRect tex1;   // generated phrase
uniform sampler2DRect tex2;   // training loss curve, 64 x 1, red = loss / first epoch
uniform float nloss;

const float PI = 3.14159265;

float q(int i) {
	if (i == 0) return qa.x;
	if (i == 1) return qa.y;
	if (i == 2) return qa.z;
	if (i == 3) return qa.w;
	return qb;
}

// ---- noise ---------------------------------------------------------------

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

float vnoise(vec2 p) {
	vec2 i = floor(p), f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x),
	           mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}

float fbm(vec2 p) {
	float v = 0.0, a = 0.5;
	for (int i = 0; i < 5; i++) {
		v += a * vnoise(p);
		p = p * 2.03 + vec2(1.7, 9.2);
		a *= 0.5;
	}
	return v;
}

// Noise that radiates: instead of sliding the field, zoom it out from the
// centre so features are born in the middle and grow outward. Two layers half
// a cycle apart are cross-faded so the zoom can reset without a visible jump,
// and feature size stays roughly constant.
float radiate(vec2 p, float scale, float t, float seed) {
	float ph = fract(t);
	float ph2 = fract(t + 0.5);
	float a = fbm(p * scale * exp(-ph * 0.7) + seed);
	float b = fbm(p * scale * exp(-ph2 * 0.7) + seed + 17.3);
	float w = abs(ph - 0.5) * 2.0;
	return mix(a, b, w);
}

vec2 rot2(vec2 p, float a) { float c = cos(a), s = sin(a); return vec2(c * p.x - s * p.y, s * p.x + c * p.y); }

// ---- step data -----------------------------------------------------------

float learned(float i)   { return texture2DRect(tex0, vec2(i + 0.5, 0.5)).r; }
float generated(float i) { return texture2DRect(tex1, vec2(i + 0.5, 0.5)).r; }

float lossAt(float i) { return texture2DRect(tex2, vec2(i + 0.5, 0.5)).r; }

// Pitch class -> a muted palette, laid out around the circle of fifths so
// closely related keys sit in neighbouring colours.
vec3 pitchColor(float pitch) {
	int i = int(mod(mod(pitch, 12.0) * 7.0, 12.0));   // position on the circle of fifths
	if (i == 0)  return vec3(0.72, 0.66, 0.55);   // C   sand
	if (i == 1)  return vec3(0.78, 0.62, 0.50);   // G   clay
	if (i == 2)  return vec3(0.76, 0.55, 0.52);   // D   dusty rose
	if (i == 3)  return vec3(0.70, 0.52, 0.60);   // A   mauve
	if (i == 4)  return vec3(0.58, 0.52, 0.66);   // E   lavender
	if (i == 5)  return vec3(0.48, 0.55, 0.70);   // B   slate blue
	if (i == 6)  return vec3(0.45, 0.62, 0.70);   // F#  steel teal
	if (i == 7)  return vec3(0.48, 0.68, 0.64);   // C#  sage teal
	if (i == 8)  return vec3(0.55, 0.70, 0.55);   // G#  sage
	if (i == 9)  return vec3(0.66, 0.72, 0.52);   // D#  olive
	if (i == 10) return vec3(0.75, 0.72, 0.52);   // A#  straw
	return vec3(0.78, 0.70, 0.58);                // F   wheat
}

// square marker
float sq(vec2 d, float s) { return 1.0 - smoothstep(s, s + 0.004, max(abs(d.x), abs(d.y))); }

// a ruler of n steps between xa..xb at height y; tick height follows pitch
vec3 ruler(vec2 p, float n, float xa, float xb, float y, bool gen, vec3 tint, float cursor) {
	if (n < 1.0) {
		// nothing loaded: a resting scale of sixteen faint ticks on a baseline
		float w0 = (xb - xa) / 16.0;
		float k0 = floor((p.x - xa) / w0);
		if (k0 < 0.0 || k0 >= 16.0) return vec3(0.0);
		float cx0 = xa + (k0 + 0.5) * w0;
		float t0 = (1.0 - smoothstep(0.003, 0.006, abs(p.x - cx0))) * (1.0 - smoothstep(0.012, 0.018, abs(p.y - y)));
		float b0 = (1.0 - smoothstep(0.0025, 0.005, abs(p.y - y))) * 0.25;
		return tint * (t0 * 0.35 + b0);
	}
	float w = (xb - xa) / n;
	float k = floor((p.x - xa) / w);
	if (k < 0.0 || k >= n) return vec3(0.0);
	float cx = xa + (k + 0.5) * w;
	float v = gen ? generated(k) : learned(k);
	float has = step(0.002, v);
	float h = 0.012 + 0.06 * has * clamp((v * 255.0 - 36.0) / 60.0, 0.1, 1.0);
	float bar = (1.0 - smoothstep(w * 0.18, w * 0.26, abs(p.x - cx))) *
	            (1.0 - smoothstep(h, h + 0.006, abs(p.y - y)));
	float base = (1.0 - smoothstep(0.0025, 0.005, abs(p.y - y))) * 0.35;
	// the step under the playhead: lit, with a soft glow around it
	float here = (cursor >= 0.0 && floor(cursor) == k) ? 1.0 : 0.0;
	float glow = exp(-pow((p.x - cx) / (w * 0.9), 2.0) - pow((p.y - y) / 0.09, 2.0)) * here;
	vec3 barCol = mix(tint * 0.5, pitchColor(v * 255.0) * 1.15, has);
	return barCol * bar + tint * base + vec3(1.0) * (bar * here * 0.8 + glow * (0.15 + 0.35 * has));
}

void main() {
	vec2 p = (uv - 0.5) * vec2(aspect, 1.0) * 2.0;   // y in -1..1

	float training   = step(0.5, stage) * step(stage, 1.5);
	float generating = step(1.5, stage) * step(stage, 2.5);
	float done       = step(2.5, stage) * step(stage, 3.5);
	float error      = step(3.5, stage);
	float busy = training + generating;

	vec3 bg = vec3(0.075, 0.078, 0.09);
	vec3 col = bg;
	vec3 ink = vec3(0.62, 0.66, 0.74);                        // HUD lines
	vec3 blue = mix(vec3(0.12, 0.45, 1.0), vec3(0.6, 0.3, 0.95), pitch * 0.6);
	vec3 pale = vec3(0.9, 0.96, 1.0);
	vec3 core = vec3(0.95, 0.9, 0.5);

	// ---- bloom ------------------------------------------------------------

	float rot = time * (0.05 + 0.5 * training + 0.15 * generating);
	float r = length(p);
	float th = atan(p.y, p.x) + rot;

	// five petals, one per qubit
	float petal = 0.0;
	for (int i = 0; i < 5; i++) {
		float a = th - float(i) * 2.0 * PI / 5.0;
		float lobe = pow(max(cos(a), 0.0), 3.0);            // one lobe per fifth of the circle
		petal += (0.18 + 0.32 * q(i)) * lobe;
	}

	// domain warp: variation is the dial, coherence is how crisp the readout is
	float warpAmt = 0.08 + 0.22 * variation;
	// large-scale noise radiating from the centre, with a slow turn
	vec2 pr = rot2(p, time * 0.03);
	float n1 = radiate(pr, 2.2, time * 0.05, 0.0);
	float n2 = radiate(pr * 1.9 + n1 * 2.0, 2.2, time * 0.05, 5.2);
	float rShape = 0.2 + 0.55 * petal + (n2 - 0.5) * warpAmt * 1.6;
	float edge = 0.04 + 0.16 * (1.0 - coherence) + 0.06 * variation;
	float body = 1.0 - smoothstep(rShape - edge, rShape + edge * 0.5, r);

	// particulate texture: fine noise plus a dot lattice, scattered by variation
	float grain = radiate(pr + n1 * 0.35, 9.0, time * 0.08, 11.0);
	vec2 lat = fract(p * (34.0 + 10.0 * variation) + n2 * variation * 2.0) - 0.5;
	float dots = 1.0 - smoothstep(0.18, 0.34, length(lat));
	float density = body * (0.5 + 0.9 * grain) * (0.6 + 0.6 * dots);
	density *= 1.0 + 0.35 * generating * sin(time * 6.0 - r * 12.0);
	density *= 1.0 + 0.6 * done;

	vec3 bloom = mix(blue, pale, smoothstep(0.35, 1.1, density));
	bloom = mix(bloom, core, (1.0 - smoothstep(0.0, 0.2, r)) * 0.8 * body);
	bloom = mix(bloom, vec3(0.9, 0.3, 0.25), error * 0.6);
	col = mix(col, bloom, clamp(density, 0.0, 1.0));
	col += bloom * body * 0.3;                                   // additive lift
	// lit rim along the edge of the form
	float rim = smoothstep(rShape - edge, rShape, r) * (1.0 - smoothstep(rShape, rShape + edge * 0.5, r));
	col += pale * rim * 0.6 * (0.5 + 0.5 * grain);
	// bloom: light spilling past the edge, brighter where the form is dense,
	// and a wider softer wash so the whole thing sits in a glow
	float spill = exp(-max(r - rShape, 0.0) * 9.0) * (0.35 + 0.65 * grain);
	float wash = exp(-max(r - rShape, 0.0) * 2.5) * 0.25;
	col += mix(blue, pale, 0.3) * (spill * 0.55 + wash) * (1.0 + 0.5 * done + 0.3 * generating);
	col += core * (1.0 - smoothstep(0.0, 0.35, r)) * body * 0.35;
	// faint halo of loose particles beyond the edge
	float halo = (1.0 - smoothstep(rShape, rShape + 0.35 * variation, r)) * grain * dots * 0.35;
	col += blue * halo * (1.0 - body);

	// ---- ring: one point per step ----------------------------------------

	float R = 0.80;
	float n = max(steps, 1.0);
	float ang = atan(p.y, p.x);
	float ringLine = 1.0 - smoothstep(0.0025, 0.005, abs(r - R));
	col += ink * ringLine * (0.35 + 0.25 * playing);
	// a second, larger circle, clipped by the top and bottom edges into two arcs
	// faded out towards the rulers so the arcs never cross them
	float R2 = (R + aspect) * 0.5;
	float arcFade = 1.0 - smoothstep(0.45, 0.78, abs(p.y));
	col += ink * (1.0 - smoothstep(0.0025, 0.005, abs(r - R2))) * 0.3 * arcFade;

	// step 0 at the top, running clockwise
	float k = floor(fract(0.25 - ang / (2.0 * PI)) * n);
	float ka = PI * 0.5 - (k + 0.5) / n * 2.0 * PI;
	vec2 pk = vec2(cos(ka), sin(ka)) * R;
	// Until a phrase exists, the learned loop is tiled around the ring: the
	// ring is the phrase to come, and the loop is what it grows from.
	bool showGen = ngen > 0.5;
	float len = showGen ? ngen : nlearn;
	float v = 0.0;
	if (len > 0.5) {
		float kk = showGen ? k : mod(k, len);
		v = (showGen && k >= len) ? 0.0 : (showGen ? generated(kk) : learned(kk));
	}
	float has = step(0.002, v);
	// beat pulse when Live is running: every point swells and brightens on the beat
	float pulse = playing * pow(1.0 - beat, 3.0);
	float tick = 1.0 - smoothstep(0.006 + 0.004 * pulse, 0.011 + 0.006 * pulse, length(p - pk));
	float s = (0.014 + 0.022 * clamp((v * 255.0 - 36.0) / 60.0, 0.0, 1.0)) * (1.0 + 0.35 * pulse);
	float mark = sq(p - pk, s) * has;
	vec3 noteCol = pitchColor(v * 255.0) * 1.2;
	col += ink * tick * (0.7 + 0.5 * pulse) + noteCol * mark * (1.0 + 0.6 * pulse);
	col += noteCol * exp(-pow(length(p - pk) / (s * 2.5), 2.0)) * has * 0.35;   // glow
	// playhead: if the ring shows what the track is playing, light the step under it
	float ringKind = showGen ? 2.0 : 1.0;
	if (play.x > 0.5 && abs(play.x - ringKind) < 0.5 && len > 0.5) {
		float cur = showGen ? floor(play.y) : mod(floor(play.y), len);
		float rk = showGen ? k : mod(k, len);
		float here = (floor(rk) == cur) ? 1.0 : 0.0;
		// while tiling the loop, every repeat of the step lights up together
		float hd = length(p - pk);
		col += vec3(1.0) * here * (sq(p - pk, s + 0.006) * 0.9 + exp(-pow(hd / 0.09, 2.0)) * 0.5);
	}

	// progress as one line along the outer circle's visible arcs: down the
	// right arc for the first half, then up the left arc for the second
	float a0 = asin(min(0.8 / R2, 1.0));                 // half-angle of a visible arc
	// angle measured so each arc runs monotonically from its top end to its bottom
	// end: on the right ang goes a0 -> -a0; on the left, unwrapped past pi, it
	// goes (pi - a0) -> (pi + a0)
	float angU = ang < 0.0 ? ang + 2.0 * PI : ang;
	float fromTop = p.x >= 0.0 ? (a0 - ang) : (angU - (PI - a0));
	float t = fromTop / (2.0 * a0);                      // 0 at the top end, 1 at the bottom end
	float inArc = step(0.0, t) * step(t, 1.0);
	float along = p.x >= 0.0 ? t * 0.5 : 0.5 + (1.0 - t) * 0.5;
	float arcOn = (step(along, progress) * busy + done) * inArc;
	float arcVis = 1.0 - smoothstep(0.72, 0.8, abs(p.y));
	col += mix(pale, blue, 0.5) * (1.0 - smoothstep(0.012, 0.02, abs(r - R2))) * arcOn * arcVis * 0.9;

	// ---- rulers -------------------------------------------------------------

	float xa = -aspect * 0.86, xb = aspect * 0.86;
	col += ruler(p, nlearn, xa, xb, 0.9, false, ink, abs(play.x - 1.0) < 0.5 ? play.y : -1.0);
	col += ruler(p, ngen, xa, xb, -0.9, true, mix(pale, blue, 0.4), abs(play.x - 2.0) < 0.5 ? play.y : -1.0);

	// training loss curve, bottom left: how the readout settled, epoch by epoch
	if (nloss > 1.5) {
		vec2 lo = vec2(-aspect + 0.16, -0.78), hi = vec2(-aspect + 0.72, -0.42);
		vec2 c = (p - lo) / (hi - lo);
		if (c.x >= 0.0 && c.x <= 1.0 && c.y >= -0.05 && c.y <= 1.1) {
			float e = c.x * (nloss - 1.0);
			float e0 = floor(e);
			float y = mix(lossAt(e0), lossAt(min(e0 + 1.0, nloss - 1.0)), fract(e));
			float d = abs(c.y - y);
			float curve = 1.0 - smoothstep(0.02, 0.05, d);
			float fill = (1.0 - smoothstep(0.0, 0.45, c.y - y)) * step(c.y, y) * 0.12;
			float axis = (1.0 - smoothstep(0.0, 0.03, abs(c.y))) * 0.35;
			col += ink * (curve * 0.7 + axis) + blue * fill;
		}
	}

	// corner brackets, because it is an instrument panel
	vec2 ap = abs(p) - vec2(aspect - 0.06, 0.94);
	float br = (1.0 - smoothstep(0.0, 0.004, abs(max(ap.x, ap.y)))) * step(-0.12, min(ap.x, ap.y));
	col += ink * br * 0.5;

	// vignette + grain
	col = mix(bg, col, 0.5 + 0.5 * (1.0 - smoothstep(0.9, 2.2, r)));
	col += (hash(uv * 900.0 + fract(time)) - 0.5) * 0.02;

	// rounded corners: outside the rounded rect, paint the device background
	vec2 inner = vec2(aspect, 1.0) - radius;
	vec2 dc = abs(p) - inner;
	float dRect = length(max(dc, 0.0)) + min(max(dc.x, dc.y), 0.0) - radius;
	float px = 2.0 / 160.0;                                    // one pixel at the view's height
	col = mix(col, panel, smoothstep(-px, px * 0.5, dRect));

	gl_FragColor = vec4(col, 1.0);
}
]]>
		</program>
	</language>
</jittershader>
